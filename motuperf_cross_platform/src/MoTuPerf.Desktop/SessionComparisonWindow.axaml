<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoTuPerf.Desktop.SessionComparisonWindow"
        Title="对比分析" Width="1160" Height="760" MinWidth="900" MinHeight="580"
        WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0" WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Expander.comparisonSelector /template/ Border#ExpanderContent">
      <Setter Property="Padding" Value="12,12,12,14" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource Theme.DialogBackground}" />
    </Style>
    <Style Selector="Expander.comparisonSelector /template/ ToggleButton#ExpanderHeader">
      <Setter Property="Background" Value="{DynamicResource Theme.DialogSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.DialogSeparator}" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="Expander.comparisonSelector /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
    </Style>
    <Style Selector="Expander.comparisonSelector /template/ ToggleButton#ExpanderHeader /template/ Path#ExpandCollapseChevron">
      <Setter Property="Stroke" Value="{DynamicResource Theme.TextSecondary}" />
    </Style>
    <Style Selector="Expander.comparisonDetails /template/ Border#ExpanderContent">
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource Theme.DialogBackground}" />
    </Style>
    <Style Selector="Expander.comparisonDetails /template/ ToggleButton#ExpanderHeader">
      <Setter Property="Background" Value="{DynamicResource Theme.DialogSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.DialogSeparator}" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="Expander.comparisonDetails /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
    </Style>
    <Style Selector="Expander.comparisonDetails /template/ ToggleButton#ExpanderHeader /template/ Path#ExpandCollapseChevron">
      <Setter Property="Stroke" Value="{DynamicResource Theme.TextSecondary}" />
    </Style>
    <Style Selector="Button.comparisonAction">
      <Setter Property="Background" Value="{DynamicResource Theme.DialogSurface}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.DialogBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="TextBox.comparisonTime">
      <Setter Property="Background" Value="{DynamicResource Theme.DialogInputBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.DialogBorder}" />
    </Style>
    <Style Selector="ContextMenu.comparisonMenu">
      <Setter Property="Background" Value="{DynamicResource Theme.PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ContextMenu.comparisonMenu MenuItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="ContextMenu.comparisonMenu MenuItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
    </Style>
  </Window.Styles>
  <Border Classes="secondaryWindowFrame">
    <Grid RowDefinitions="48,Auto,*,48">
      <Border Classes="dialogTitleBar" PointerPressed="MoveTitle">
        <Grid ColumnDefinitions="*,46">
          <TextBlock Text="对比分析" Classes="sectionTitle" Margin="22,0" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="windowButton closeButton" Content="&#x00D7;" Click="CloseWindow" ToolTip.Tip="关闭" />
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Margin="18,12,18,10" Spacing="10">
        <Expander x:Name="SelectionExpander" Classes="comparisonSelector" Header="选择数据" IsExpanded="True">
          <UniformGrid x:Name="SlotsPanel" Columns="5" />
        </Expander>
        <Grid x:Name="OptionsPanel" ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <RadioButton x:Name="AverageMode" Content="均值" GroupName="comparisonMode" IsChecked="True" IsCheckedChanged="ModeChanged" />
            <RadioButton x:Name="PeakMode" Content="峰值" GroupName="comparisonMode" IsCheckedChanged="ModeChanged" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="区间（秒）" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}" />
            <TextBox x:Name="StartTimeInput" Classes="comparisonTime" Text="0" Width="78" TextChanged="RangeEdited" ToolTip.Tip="相对各现场起点的开始秒数" />
            <TextBlock Text="至" VerticalAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}" />
            <TextBox x:Name="EndTimeInput" Classes="comparisonTime" Width="78" PlaceholderText="结束" TextChanged="RangeEdited" ToolTip.Tip="留空表示各自记录末尾" />
            <Button Classes="comparisonAction" Content="应用" Click="ApplyRange" />
            <Button Classes="comparisonAction" Content="全部" Click="ResetRange" />
          </StackPanel>
        </Grid>
      </StackPanel>
      <Grid Grid.Row="2" Margin="18,0,18,0" RowDefinitions="Auto,*">
        <Grid x:Name="TableHeader" Width="{Binding #TableRows.Bounds.Width}" HorizontalAlignment="Left" Background="{DynamicResource Theme.DialogSurface}" />
        <ScrollViewer x:Name="TableScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="TableRows" />
        </ScrollViewer>
      </Grid>
      <Border Grid.Row="3" Classes="dialogFooter">
        <Grid ColumnDefinitions="*,Auto" Margin="18,0">
          <TextBlock x:Name="StatusText" Text="选择至少两份现场进行对比；缺测显示 --。" VerticalAlignment="Center"
                     Foreground="{DynamicResource Theme.TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
          <Button x:Name="ExportButton" Grid.Column="1" Content="导出对比 CSV" Classes="primaryToolbarButton" Click="ExportComparison" IsEnabled="False" />
        </Grid>
      </Border>
      <Border x:Name="BusyOverlay" Grid.RowSpan="4" Background="{DynamicResource Theme.DialogBackground}" IsVisible="False">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Spacing="18">
          <TextBlock x:Name="BusyText" Text="正在读取现场与计算统计…" FontSize="18" TextAlignment="Center" Foreground="{DynamicResource Theme.TextPrimary}" />
          <ProgressBar IsIndeterminate="True" Height="5" />
          <TextBlock Text="请等待处理完成" TextAlignment="Center" Foreground="{DynamicResource Theme.TextSecondary}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
