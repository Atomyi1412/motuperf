<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoTuPerf.Desktop.ExportCsvDialogWindow"
        Title="选择导出方式"
        Width="500"
        Height="230"
        CanResize="False"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        WindowStartupLocation="CenterOwner">
  <Border Classes="secondaryWindowFrame">
    <Grid RowDefinitions="46,*,52">
      <Border Classes="dialogTitleBar">
        <TextBlock Text="选择导出方式" Classes="sectionTitle" VerticalAlignment="Center" Margin="18,0,0,0" />
      </Border>

      <StackPanel Grid.Row="1" Margin="18,12" Spacing="10">
        <TextBlock Text="默认使用秒级汇总；现场文件仍保留完整原始数据。" Classes="dialogHint" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <Button Classes="exportModeButton recommended" HorizontalAlignment="Stretch" Click="ExportSummary">
            <StackPanel Spacing="5">
              <TextBlock Text="秒级汇总" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Accent}" />
              <TextBlock Text="每秒一行 · 推荐" FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="exportModeButton" HorizontalAlignment="Stretch" Click="ExportRawDetail">
            <StackPanel Spacing="5">
              <TextBlock Text="原始明细" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextPrimary}" />
              <TextBlock Text="保留全部采样行" FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>

      <Border Grid.Row="2" Classes="dialogFooter" Padding="10,0">
        <Button Classes="dialogFooterButton" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Cancel">取消</Button>
      </Border>
    </Grid>
  </Border>
</Window>
