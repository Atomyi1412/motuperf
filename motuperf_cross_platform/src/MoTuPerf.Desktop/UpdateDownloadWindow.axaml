<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoTuPerf.Desktop.UpdateDownloadWindow"
        Title="下载更新"
        Width="520"
        Height="240"
        CanResize="False"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        WindowStartupLocation="CenterOwner">
  <Border Classes="secondaryWindowFrame">
    <Grid RowDefinitions="48,*,58">
      <Border Classes="dialogTitleBar" PointerPressed="DialogTitlePointerPressed">
        <TextBlock Text="正在下载更新" Classes="sectionTitle" VerticalAlignment="Center" Margin="18,0,0,0" />
      </Border>
      <StackPanel Grid.Row="1" Margin="24,20" Spacing="12">
        <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="10" />
        <TextBlock x:Name="Detail" Classes="dialogHint" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Border Grid.Row="2" Classes="dialogFooter" Padding="12,0">
        <Button x:Name="CancelButton" Classes="toolbarButton" Content="取消" Click="Cancel" HorizontalAlignment="Right" Width="86" />
      </Border>
    </Grid>
  </Border>
</Window>
