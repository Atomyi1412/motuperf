    <SolidColorBrush x:Key="Theme.WindowBackground">#0F1018</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.TitleBarBackground">#181A24</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.ToolbarBackground">#181820</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.PanelBackground">#181923</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.PanelHeaderBackground">#191A24</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.CardBackground">#1B1C27</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.InputBackground">#31313F</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.HoverBackground">#242532</SolidColorBrush>
