    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="MinHeight" Value="18" />
      <Setter Property="Padding" Value="8,0,0,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="18,*" MinHeight="18">
            <Border x:Name="PART_CheckBox"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Theme.CheckboxBackground}"
                    BorderBrush="{DynamicResource Theme.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="0">
              <Grid>
                <Viewbox Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path x:Name="PART_CheckGlyph"
                        Data="M5.5 10.586 1.707 6.793A1 1 0 0 0 .293 8.207l4.5 4.5a1 1 0 0 0 1.414 0l11-11A1 1 0 0 0 15.793.293L5.5 10.586Z"
                        Fill="{DynamicResource Theme.CheckboxGlyph}"
                        Stretch="Uniform"
                        Opacity="0" />
                </Viewbox>
                <Border x:Name="PART_IndeterminateGlyph"
                        Width="8"
                        Height="2"
                        Background="{DynamicResource Theme.CheckboxGlyph}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0" />
              </Grid>
            </Border>
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Grid.Column="1"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Margin="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="CheckBox:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
    </Style>
    <Style Selector="CheckBox:pointerover /template/ Border#PART_CheckBox">
      <Setter Property="Background" Value="{DynamicResource Theme.CheckboxHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
    </Style>
    <Style Selector="CheckBox:pressed /template/ Border#PART_CheckBox">
      <Setter Property="Background" Value="{DynamicResource Theme.CheckboxPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Path#PART_CheckGlyph">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="CheckBox:indeterminate /template/ Border#PART_IndeterminateGlyph">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="CheckBox:disabled /template/ Border#PART_CheckBox">
      <Setter Property="Background" Value="{DynamicResource Theme.CheckboxDisabled}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.TextMuted}" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="CheckBox:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
    </Style>
