<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MoTuPerf.Desktop.App">
  <Application.Resources>
    <SolidColorBrush x:Key="Theme.WindowBackground">#0F1018</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.TitleBarBackground">#181A24</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.ToolbarBackground">#181820</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.PanelBackground">#181923</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.PanelHeaderBackground">#191A24</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.CardBackground">#1B1C27</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.InputBackground">#31313F</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.HoverBackground">#242532</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.PressedBackground">#303240</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.SelectedBackground">#2A2C3C</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.ChartBackground">#161720</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.ChartGrid">#383A4A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.TextPrimary">#EBECF4</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.TextSecondary">#ACAEBE</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.TextMuted">#777A8C</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.TextOnAccent">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Border">#292B3A</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.BorderStrong">#424456</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.ScrollTrack">#0D0E15</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.ScrollThumb">#5B5C60</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.ScrollThumbHover">#7B7D84</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Cursor">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.OverlayBackground">#08090D</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.CheckboxBackground">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.CheckboxGlyph">#1A1B22</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.CheckboxHover">#F4F4F5</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.CheckboxPressed">#E3E4E8</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.CheckboxDisabled">#B8B9BE</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.Accent">#1476FF</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.DialogBackground">#22242C</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.DialogSurface">#2B2E38</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.DialogFooterBackground">#1E2028</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.DialogBorder">#676D7D</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.DialogSeparator">#404553</SolidColorBrush>
    <SolidColorBrush x:Key="Theme.DialogInputBackground">#30343F</SolidColorBrush>
    <x:Double x:Key="Theme.WorkspaceTextureOpacity">0</x:Double>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource Theme.WindowBackground}" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Inter, sans-serif" />
      <Setter Property="Win32Properties.WindowCornerPreference" Value="Round" />
    </Style>

    <Style Selector="Border.mainWindowFrame">
      <Setter Property="Background" Value="{DynamicResource Theme.WindowBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Window[WindowState=Maximized] Border.mainWindowFrame, Window[WindowState=FullScreen] Border.mainWindowFrame">
      <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Border.sessionLoadingOverlay">
      <Setter Property="Background" Value="{DynamicResource Theme.WindowBackground}" />
      <Setter Property="Opacity" Value="0.97" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.sessionLoadingPanel">
      <Setter Property="Background" Value="{DynamicResource Theme.PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="30,25" />
      <Setter Property="Width" Value="420" />
      <Setter Property="BoxShadow" Value="0 4 18 0 #66000000" />
    </Style>
    <Style Selector="TextBlock.sessionLoadingTitle">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="ProgressBar.sessionLoadingProgress">
      <Setter Property="Height" Value="6" />
      <Setter Property="MinWidth" Value="360" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
      <Setter Property="Background" Value="{DynamicResource Theme.ScrollTrack}" />
    </Style>
    <Style Selector="TextBlock.sessionLoadingProgressText">
      <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxWidth" Value="360" />
    </Style>
    <Style Selector="TextBlock.sessionLoadingDetail">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.helpLinkButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.helpLinkButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="Padding" Value="6,3" />
    </Style>

    <Style Selector="Border.secondaryWindowFrame">
      <Setter Property="Background" Value="{DynamicResource Theme.DialogBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.DialogBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Window[WindowState=Maximized] Border.secondaryWindowFrame, Window[WindowState=FullScreen] Border.secondaryWindowFrame">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.dialogTitleBar">
      <Setter Property="Background" Value="{DynamicResource Theme.TitleBarBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.DialogSeparator}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.dialogFooter">
      <Setter Property="Background" Value="{DynamicResource Theme.DialogFooterBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.DialogSeparator}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style Selector="Button">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Inter, sans-serif" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Theme.PressedBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Theme.CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.toolbarButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="Margin" Value="5,0" />
      <Setter Property="MinWidth" Value="84" />
      <Setter Property="Height" Value="40" />
    </Style>
    <Style Selector="Button.toolbarButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    </Style>
    <Style Selector="Button.toolbarButton:pressed">
      <Setter Property="Background" Value="{DynamicResource Theme.PressedBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
    </Style>
    <Style Selector="TextBlock.toolbarIcon">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets, sans-serif" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.toolbarText">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primaryToolbarButton">
      <Setter Property="Background" Value="{DynamicResource Theme.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextOnAccent}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="15,8" />
      <Setter Property="MinWidth" Value="150" />
    </Style>
    <Style Selector="Button.primaryToolbarButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    </Style>
    <Style Selector="Button.primaryToolbarButton:pressed">
      <Setter Property="Background" Value="{DynamicResource Theme.PressedBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
    </Style>
    <Style Selector="Button.captureToolbarButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="MinWidth" Value="150" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Height" Value="44" />
    </Style>
    <Style Selector="Button.captureToolbarButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    </Style>
    <Style Selector="Button.captureToolbarButton:pressed">
      <Setter Property="Background" Value="{DynamicResource Theme.PressedBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
    </Style>
    <Style Selector="TextBlock.captureStartIcon">
      <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.captureStopIcon">
      <Setter Property="Foreground" Value="#F45B86" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.captureButtonText">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.captureToolbarButton:pointerover TextBlock.captureButtonText">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.followText">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Margin" Value="20,0,6,0" />
    </Style>
    <Style Selector="Button.windowButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="40" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.windowButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    </Style>
    <Style Selector="Button.windowButton.closeButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
    </Style>
    <Style Selector="Button.themeSelectorButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.themeSelectorButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    </Style>
    <Style Selector="Button.themeSelectorButton:pressed">
      <Setter Property="Background" Value="{DynamicResource Theme.PressedBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
    </Style>
    <Style Selector="TextBlock.themeSelectorIcon">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets, sans-serif" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.settingsMenuIcon">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets, sans-serif" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="FlyoutPresenter.themeFlyoutPresenter">
      <Setter Property="Background" Value="{DynamicResource Theme.PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.themeMenuSurface">
      <Setter Property="Background" Value="{DynamicResource Theme.PanelBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="MinWidth" Value="132" />
    </Style>
    <Style Selector="Button.themeOptionButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.themeOptionButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    </Style>
    <Style Selector="Button.themeOptionButton:pressed">
      <Setter Property="Background" Value="{DynamicResource Theme.PressedBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
    </Style>
    <Style Selector="Button.smallDialogButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Height" Value="28" />
    </Style>
    <Style Selector="Button.smallDialogButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
    </Style>
    <Style Selector="Border.dataCleanupListSurface">
      <Setter Property="Background" Value="{DynamicResource Theme.DialogSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBox.dataCleanupList > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.dataCleanupRow">
      <Setter Property="Background" Value="{DynamicResource Theme.DialogSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="ListBox.dataCleanupList > ListBoxItem:pointerover Border.dataCleanupRow">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
    </Style>
    <Style Selector="TextBlock.dataCleanupSize">
      <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.dialogTextBox">
      <Setter Property="Background" Value="{DynamicResource Theme.DialogInputBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Height" Value="40" />
    </Style>
    <Style Selector="TextBlock.themeOptionText">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.panelToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.deviceInfoButton">
      <Setter Property="Background" Value="{DynamicResource Theme.OverlayBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.OverlayBackground}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}" />
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="23" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.deviceInfoButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
    </Style>
    <Style Selector="Button.panelToggleButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
    </Style>
    <Style Selector="Button.chartZoomResetButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chartZoomResetButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
    </Style>
    <Style Selector="Button.chartZoomResetButton:pressed">
      <Setter Property="Background" Value="{DynamicResource Theme.PressedBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
    </Style>
    <Style Selector="Button.collapsedPanelButton">
      <Setter Property="Background" Value="{DynamicResource Theme.SelectedBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.BorderStrong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.collapsedPanelButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
    </Style>

    <Style Selector="Button.dataTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.SelectedBackground}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.dataTab:pointerover">
      <Setter Property="Background" Value="{DynamicResource Theme.HoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
    </Style>
    <Style Selector="Button.dataTab.activeTab">
      <Setter Property="Background" Value="{DynamicResource Theme.SelectedBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.dataTabText">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextMuted}" />
    </Style>
    <Style Selector="TextBlock.analysisHeaderText">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.analysisValueText">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.analysisRow">
      <Setter Property="Background" Value="{DynamicResource Theme.SelectedBackground}" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Button.dataTab:pointerover TextBlock.dataTabText">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
    </Style>
    <Style Selector="Button.dataTab.activeTab TextBlock.dataTabText">
      <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}" />
    </Style>
    <Style Selector="Button.dataTab.activeTab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
