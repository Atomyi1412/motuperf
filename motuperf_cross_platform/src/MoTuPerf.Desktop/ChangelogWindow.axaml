<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoTuPerf.Desktop.ChangelogWindow"
        Title="更新日志"
        Width="700"
        SizeToContent="Height"
        MaxHeight="640"
        MinWidth="620"
        CanResize="False"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        WindowStartupLocation="CenterOwner">
  <Border Classes="secondaryWindowFrame">
    <Grid RowDefinitions="48,*,58">
      <Border Grid.Row="0" Classes="dialogTitleBar" PointerPressed="DialogTitlePointerPressed">
        <Grid ColumnDefinitions="*,46">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
            <PathIcon Data="{StaticResource IconHistory}" Foreground="{DynamicResource Theme.Accent}" Width="18" Height="18" Margin="0,0,10,0" />
            <TextBlock Text="更新日志" Classes="sectionTitle" />
          </StackPanel>
          <Button Grid.Column="1" Classes="windowButton closeButton" Content="&#x00D7;" Click="CloseWindow" ToolTip.Tip="关闭" />
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="22,10,18,12" Spacing="9">
          <Border Classes="helpSection">
            <StackPanel>
              <TextBlock Text="v0.49.0" Classes="helpTitle" />
              <TextBlock Text="2026-10-21" Classes="dialogHint" />
              <TextBlock Classes="helpBody" TextWrapping="Wrap" Text="• 对比分析界面参考 Gears 的紧凑布局重构：选择数据可折叠，A-E 彩色槽与表头对应，点击槽可从已加载记录复用、加入当前现场或导入文件；指标改为分组名称加子指标并合并同组行，首屏信息密度和长列表滚动更清晰。统计口径、均值/峰值、区间与 CSV 导出不变。" />
            </StackPanel>
          </Border>
          <Border Classes="helpSection">
            <StackPanel>
              <TextBlock Text="v0.48.0" Classes="helpTitle" />
              <TextBlock Text="2026-10-20" Classes="dialogHint" />
              <TextBlock Classes="helpBody" TextWrapping="Wrap" Text="• 精简对比分析主表：FPS 范围、帧来源及统计口径等说明移入表尾默认收起的“口径详情”，屏幕刷新率移至上方设备信息；导出 CSV 仍保留完整口径数据。" />
            </StackPanel>
          </Border>
          <Border Classes="helpSection">
            <StackPanel>
              <TextBlock Text="v0.47.1" Classes="helpTitle" />
              <TextBlock Text="2026-10-20" Classes="dialogHint" />
              <TextBlock Classes="helpBody" TextWrapping="Wrap" Text="• 修复对比分析从峰值切回均值时仍显示峰值的问题，确保切换按钮、统计表格与导出结果一致；不改变原始采集数据和统计口径。" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Classes="dialogFooter">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
          <Button Classes="helpLinkButton" Content="查看完整在线更新日志" Click="OpenVersionLog" ToolTip.Tip="打开完整在线更新日志" />
          <Button Classes="primaryToolbarButton" Content="知道了" Click="CloseWindow" Width="104" Margin="0,0,18,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
