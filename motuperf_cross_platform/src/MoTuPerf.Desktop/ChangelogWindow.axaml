<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoTuPerf.Desktop.ChangelogWindow"
        Title="更新日志"
        Width="700"
        SizeToContent="Height"
        MaxHeight="640"
        MinWidth="620"
        CanResize="False"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        WindowStartupLocation="CenterOwner">
  <Border Classes="secondaryWindowFrame">
    <Grid RowDefinitions="48,*,58">
      <Border Grid.Row="0" Classes="dialogTitleBar" PointerPressed="DialogTitlePointerPressed">
        <Grid ColumnDefinitions="*,46">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
            <PathIcon Data="{StaticResource IconHistory}" Foreground="{DynamicResource Theme.Accent}" Width="18" Height="18" Margin="0,0,10,0" />
            <TextBlock Text="更新日志" Classes="sectionTitle" />
          </StackPanel>
          <Button Grid.Column="1" Classes="windowButton closeButton" Content="&#x00D7;" Click="CloseWindow" ToolTip.Tip="关闭" />
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="22,10,18,12" Spacing="9">
          <Border Classes="helpSection">
            <StackPanel>
              <TextBlock Text="v1.0.1" Classes="helpTitle" />
              <TextBlock Text="2026-10-30" Classes="dialogHint" />
              <TextBlock Classes="helpBody" TextWrapping="Wrap" Text="• 首次设置主题时同步预览主界面与设置窗口，取消时恢复原主题。" />
            </StackPanel>
          </Border>
          <Border Classes="helpSection">
            <StackPanel>
              <TextBlock Text="v1.0.0" Classes="helpTitle" />
              <TextBlock Text="2026-10-30" Classes="dialogHint" />
              <TextBlock Classes="helpBody" TextWrapping="Wrap" Text="• 保持原有 Windows 安装和卸载界面，避免改变用户熟悉的安装流程。&#10;• 全新安装首次启动时可选择界面主题和指标名称语言，升级时保留已有设置。" />
            </StackPanel>
          </Border>
          <Border Classes="helpSection">
            <StackPanel>
              <TextBlock Text="v0.56.1" Classes="helpTitle" />
              <TextBlock Text="2026-10-30" Classes="dialogHint" />
              <TextBlock Classes="helpBody" TextWrapping="Wrap" Text="• 采集过程中禁用曲线分析入口，停止采集后恢复，避免误切换界面。" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Classes="dialogFooter">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
          <Button Classes="helpLinkButton" Content="查看完整在线更新日志" Click="OpenVersionLog" ToolTip.Tip="打开完整在线更新日志" />
          <Button Classes="primaryToolbarButton" Content="知道了" Click="CloseWindow" Width="104" Margin="0,0,18,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
