<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoTuPerf.Desktop.ChangelogWindow"
        Title="更新日志"
        Width="700"
        SizeToContent="Height"
        MaxHeight="640"
        MinWidth="620"
        CanResize="False"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        WindowStartupLocation="CenterOwner">
  <Border Classes="secondaryWindowFrame">
    <Grid RowDefinitions="48,*,58">
      <Border Grid.Row="0" Classes="dialogTitleBar" PointerPressed="DialogTitlePointerPressed">
        <Grid ColumnDefinitions="*,46">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
            <TextBlock Text="&#xE8A5;" Foreground="{DynamicResource Theme.Accent}" FontSize="18" FontFamily="Segoe MDL2 Assets, sans-serif" Margin="0,0,10,0" />
            <TextBlock Text="更新日志" Classes="sectionTitle" />
          </StackPanel>
          <Button Grid.Column="1" Classes="windowButton closeButton" Content="&#x00D7;" Click="CloseWindow" ToolTip.Tip="关闭" />
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,10,18,12" Spacing="9">
          <Border Classes="helpSection">
            <StackPanel>
              <TextBlock Text="v0.25.2" Classes="helpTitle" />
              <TextBlock Text="2026-09-22" Classes="dialogHint" />
              <TextBlock Classes="helpBody" TextWrapping="Wrap" Text="• 移除数据显示区域重复展示的设备与进程状态，保留标题栏状态信息，释放内容区空间。" />
            </StackPanel>
          </Border>
          <Border Classes="helpSection">
            <StackPanel>
              <TextBlock Text="v0.25.1" Classes="helpTitle" />
              <TextBlock Text="2026-09-22" Classes="dialogHint" />
              <TextBlock Classes="helpBody" TextWrapping="Wrap" Text="• 移除顶部无实际操作作用的“时间轴跟随”文字，减少界面干扰。" />
            </StackPanel>
          </Border>
          <Border Classes="helpSection">
            <StackPanel>
              <TextBlock Text="v0.25.0" Classes="helpTitle" />
              <TextBlock Text="2026-09-21" Classes="dialogHint" />
              <TextBlock Classes="helpBody" TextWrapping="Wrap" Text="• 新增“分析数据”页签，未选中具体数据点时按当前完整查看区间展示各指标的最大值、最小值和平均值；曲线缩放后按缩放区间统计。&#xA;• 修复分析面板高度塌缩问题，空采集数据也保留指标列表，缺测值显示为 --，不把真实 0 当成缺测。&#xA;• 同步升级客户端版本号和构建说明。" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Classes="dialogFooter">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
          <Button Classes="helpLinkButton" Content="查看完整在线更新日志" Click="OpenVersionLog" ToolTip.Tip="打开完整在线更新日志" />
          <Button Classes="primaryToolbarButton" Content="知道了" Click="CloseWindow" Width="104" Margin="0,0,18,0" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
